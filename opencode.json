{
  "$schema": "https://opencode.ai/config.json",
  
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-haiku-4-20250514",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 6000
  },
  
  "snapshot": false,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**",
      ".next/**",
      ".nuxt/**",
      ".turbo/**",
      "*.lock",
      "pnpm-lock.yaml",
      "package-lock.json",
      ".DS_Store",
      "*.log"
    ]
  }
}
